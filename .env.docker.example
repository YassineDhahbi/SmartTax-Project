# Copier vers .env :  copy .env.docker.example .env
#
# === Mode recommande : PostgreSQL dans Docker (sans VM Oracle Linux) ===
# Demarrage : docker compose --profile local-db --profile ui --profile ml up -d
#
# === Mode alternatif : PostgreSQL sur une VM ===
# Decommentez et remplacez par l IP de votre VM :
# POSTGRES_HOST=192.168.144.141

SPRING_PROFILES_ACTIVE=docker

# Nom du service Docker (smarttax-net) — pas une IP
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=arabsoft_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=MonPass123

# Kafka conteneur smarttax-kafka sur reseau smarttax-net
KAFKA_BOOTSTRAP_SERVERS=smarttax-kafka:29092

APP_BASE_URL=http://localhost:8080

# Groq (frontend Angular — publications fiscales)
GROQ_API_KEY=
