# Copier vers .env :  copy .env.example .env

# PostgreSQL
POSTGRES_DB=arabsoft_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Spring Boot (profil docker)
SPRING_PROFILES_ACTIVE=docker

# JWT (changez en production)
JWT_SECRET=change-me-in-production-use-long-random-string

# URLs des microservices (r�seau Docker)
OCR_SERVICE_URL=http://ocr:8004
FACE_VERIFICATION_SERVICE_URL=http://face-verification:8005
SENTIMENT_SERVICE_URL=http://sentiment:8010

# Kafka (reseau Docker smarttax-net, port interne 29092)
KAFKA_BOOTSTRAP_SERVERS=smarttax-kafka:29092

# URL publique du backend (liens dans les e-mails, fichiers)
APP_BASE_URL=http://localhost:8080

# Groq (IA publications fiscales : tags, correction orthographe)
GROQ_API_KEY=
