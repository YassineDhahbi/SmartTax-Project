# Copier sur la VM : cp .env.prod.example .env  (dans DEPLOY_PATH, ex. /opt/smarttax)

SPRING_PROFILES_ACTIVE=docker

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=arabsoft_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

KAFKA_BOOTSTRAP_SERVERS=smarttax-kafka:29092

APP_BASE_URL=http://localhost:8080
JWT_SECRET=change-me-in-production

# Images GHCR (CD frontend met a jour FRONTEND_IMAGE automatiquement)
FRONTEND_IMAGE=ghcr.io/yassinedhahbi/smarttax-project:latest
BACKEND_IMAGE=ghcr.io/yassinedhahbi/smarttax-backend:latest
